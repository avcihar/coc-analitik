# Clash of Clans Analytics Platform - Ortam Değişkenleri Şablonu

# 1. Clash of Clans Resmi API Token (developer.clashofclans.com adresinden alınan Bearer token)
# Not: Render'da çalıştırırken dinamik IP nedeniyle 403 almamak için RoyaleAPI proxy kullanıyorsanız
# RoyaleAPI tarafından sağlanan token'ı buraya yazın.
COC_API_TOKEN=your_clash_of_clans_api_token_here

# 2. CoC API Base URL (Varsayılan: https://api.clashofclans.com/v1)
# Proxy kullanıyorsanız (örn: RoyaleAPI proxy): https://cocproxy.royaleapi.dev/v1
COC_API_BASE=https://api.clashofclans.com/v1

# 3. Opsiyonel Redis Bağlantı Adresi (REDIS_URL tanımlı değilse veya bağlantı kurulamazsa
# uygulama çökmez; otomatik olarak dahili bellek içi (in-memory) TTL cache kullanır)
# Örnek: redis://red-xxxxxxxx:6379 veya boş bırakın
REDIS_URL=

# 4. CORS İzinleri (Virgülle ayrılmış origin listesi)
CORS_ORIGINS=*

# 5. Sunucu Portu (Render otomatik $PORT sağlar)
PORT=8000
