  "typography": {
    "fontFamilies": {
      "game": "'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "ui": "'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "fontFiles": [
        "/fonts/Plus_Jakarta_Sans/static/PlusJakartaSans-Regular.ttf",
        "/fonts/Plus_Jakarta_Sans/static/PlusJakartaSans-Medium.ttf",
        "/fonts/Plus_Jakarta_Sans/static/PlusJakartaSans-SemiBold.ttf",
        "/fonts/Plus_Jakarta_Sans/static/PlusJakartaSans-Bold.ttf",
        "/fonts/Plus_Jakarta_Sans/static/PlusJakartaSans-ExtraBold.ttf"
      ]
    },
    "scale": {
      "displayTitle": {
        "className": "game-title-stroke",
        "fontSize": "16px - 20px (1rem - 1.25rem)",
        "fontWeight": 800,
        "letterSpacing": "-0.01em",
        "textShadow": "0 2px 4px rgba(0, 0, 0, 0.72)"
      },
      "mediumTitle": {
        "className": "game-text-stroke",
        "fontSize": "14px - 20px (0.875rem - 1.25rem)",
        "fontWeight": 800,
        "letterSpacing": "-0.005em",
        "textShadow": "0 1.5px 3px rgba(0, 0, 0, 0.68)"
      },
      "sectionHeader": {
        "className": "game-text-stroke-sm",
        "fontSize": "14px - 16px (0.875rem - 1rem)",
        "fontWeight": 700,
        "textShadow": "0 1px 2px rgba(0, 0, 0, 0.35)"
      },
      "accentGold": {
        "className": "game-text-stroke-gold",
        "fontWeight": 800,
        "color": "#FFEB75",
        "textShadow": "0 1.5px 3px rgba(45, 22, 0, 0.85)"
      },
      "accentBlue": {
        "className": "game-text-stroke-blue",
        "fontWeight": 800,
        "color": "#8BE4FF",
        "textShadow": "0 1.5px 3px rgba(10, 28, 38, 0.85)"
      },
      "accentGreen": {
        "className": "game-text-stroke-green",
        "fontWeight": 800,
        "color": "#B5F55D",
        "textShadow": "0 1.5px 3px rgba(16, 40, 6, 0.85)"
      },
      "body": {
        "fontSize": "12px - 14px (0.75rem - 0.875rem)",
        "fontWeight": "400 - 600",
        "lineHeight": "1.5 - 1.625"
      },
      "inputField": {
        "fontSize": "16px (1rem)",
        "fontWeight": 600,
        "fontVariantNumeric": "tabular-nums"
      },
      "badgeCount": {
        "fontSize": "11.52px (0.72rem)",
        "fontWeight": 800,
        "lineHeight": 1.1,
        "fontVariantNumeric": "tabular-nums"
      },
      "badgeLevel": {
        "fontSize": "10.88px (0.68rem)",
        "compactFontSize": "9px",
        "fontWeight": 800,
        "lineHeight": 1,
        "fontVariantNumeric": "tabular-nums"
      },
      "statPill": {
        "fontSize": "12.8px (0.8rem)",
        "labelFontSize": "11px",
        "fontWeight": "600 / 800",
        "fontVariantNumeric": "tabular-nums"
      }
    }
  },
  "spacing": {
    "panelHeader": "0.5rem 0.9rem (8px 14.4px)",
    "panelBody": "12px (p-3) / 16px (sm:p-4) / 20px (md:p-5)",
    "sectionPanel": "12px (p-3) / 16px (sm:p-4)",
    "slotWell": "3px 6px",
    "tabStripDesktop": "8px 16px 0 16px",
    "tabStripMobile": "6px 8px 0 8px",
    "tabDesktop": "0.7rem 1.6rem (11.2px 25.6px)",
    "tabMobile": "0.45rem 0.75rem (7.2px 12px)",
    "statPill": "0.2rem 0.55rem (3.2px 8.8px)",
    "statBox": "4px 10px",
    "buttonSm": "0.35rem 0.75rem (5.6px 12px)",
    "buttonMd": "0.55rem 1.15rem (8.8px 18.4px)",
    "buttonLg": "0.75rem 1.6rem (12px 25.6px)",
    "segmentedGapMobile": "0.25rem (4px)",
    "segmentedGapDesktop": "0.35rem (5.6px)",
    "segmentedItemMobile": "0.38rem 0.48rem (6.08px 7.68px)",
    "segmentedItemDesktop": "0.5rem 0.9rem (8px 14.4px)"
  },
