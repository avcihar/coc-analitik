    "statBox": "2px solid #3A2315",
    "statPill": "1.5px solid #3A2317",
    "progressSlot": "1px solid #3A2317",
    "inputContainer": "2.5px solid #5A5552",
    "segmentedInactive": "2px solid #484137",
    "segmentedActive": "2.5px solid #FFFFFF"
  },
  "shadows": {
    "elevationLight": "0 4px 16px -2px rgba(42, 30, 18, 0.08), 0 2px 6px -1px rgba(42, 30, 18, 0.05)",
    "elevationDark": "0 8px 24px -4px rgba(14, 10, 6, 0.45), 0 2px 8px -2px rgba(14, 10, 6, 0.35)",
    "woodWindowFrame": "inset 0 2px 0 rgba(255, 255, 255, 0.15), 0 10px 25px rgba(0, 0, 0, 0.65)",
    "creamWindow": "0 10px 30px rgba(0, 0, 0, 0.7), inset 0 2px 0 rgba(255, 255, 255, 0.6), inset 0 -2px 0 #B8B6AF",
    "woodPanel": "inset 0 2px 0 rgba(255, 255, 255, 0.16), inset 0 -2px 0 rgba(0, 0, 0, 0.35), 0 5px 0 #1E0F08, 0 8px 16px rgba(0, 0, 0, 0.5)",
    "bluePanel": "inset 0 2px 0 rgba(255, 255, 255, 0.25), inset 0 -2px 0 rgba(0, 0, 0, 0.4), 0 5px 0 #160C06, 0 8px 16px rgba(0, 0, 0, 0.5)",
    "darkPanel": "inset 0 2px 0 rgba(255, 255, 255, 0.12), 0 4px 0 #120C08, 0 6px 12px rgba(0, 0, 0, 0.5)",
    "creamPanel": "inset 0 2px 0 rgba(255, 255, 255, 0.4), 0 4px 0 #24130A, 0 6px 12px rgba(0, 0, 0, 0.45)",
    "slotWell": "inset 0 3px 6px rgba(0, 0, 0, 0.65), inset 0 1px 2px rgba(0, 0, 0, 0.8), 0 1px 0 rgba(255, 255, 255, 0.12)",
    "buttonSpecular": "inset 0 1.5px 0 rgba(255, 255, 255, 0.45)",
    "buttonSilver": "0 3px 0 #7A7872, 0 4px 5px rgba(0, 0, 0, 0.4), inset 0 1.5px 0 rgba(255, 255, 255, 0.85)",
    "iconFrame": "inset 0 1.5px 0 rgba(255, 255, 255, 0.2), 0 2px 4px rgba(0, 0, 0, 0.65)",
    "iconFrameEpic": "inset 0 1.5px 0 rgba(255, 255, 255, 0.28), 0 0 8px rgba(234, 179, 8, 0.25), 0 2px 4px rgba(0, 0, 0, 0.65)"
  },
  "components": {
    "GameButton": {
      "classes": ["game-btn", "game-btn-{green|blue|red|gold}", "game-btn-{sm|md|lg}", "game-btn-panel-green", "game-btn-silver"],
      "variants": ["green", "blue", "red", "gold"],
      "sizes": {
        "sm": { "padding": "0.35rem 0.75rem", "fontSize": "0.8rem", "borderRadius": "6px", "borderWidth": "2px" },
        "md": { "padding": "0.55rem 1.15rem", "fontSize": "0.95rem", "borderRadius": "10px", "borderWidth": "2.5px" },
        "lg": { "padding": "0.75rem 1.6rem", "fontSize": "1.15rem", "borderRadius": "16px", "borderWidth": "3px" }
      },
      "states": {
        "normal": "inset 0 1.5px 0 specular highlight, zero outer drop shadow",
        "hover": "filter: brightness(1.08)",
        "active": "transform: scale(0.97), inset 0 1px 0 rgba(255,255,255,0.3)",
        "disabled": "filter: grayscale(0.85) opacity(0.65), cursor: not-allowed, transform: none",
        "focusVisible": "outline: 3px solid #FFEB75; outline-offset: 2px"
      }
    },
    "IconFrame": {
      "classes": ["game-icon-frame", "game-tile-{type}", "game-icon-frame-{rarity}"],
      "sizes": {
        "xs": "28x28px",
        "sm": "36x36px",
        "md": "44x44px",
        "lg": "56x56px",
        "unit": { "mobile": "44x44px", "sm": "50x50px", "md": "56x56px", "lg": "58x58px" },
        "hero": { "mobile": "44x44px", "sm": "50x50px", "md": "56x56px", "lg": "58x58px" },
        "equipment": { "mobile": "20x20px", "sm": "23x23px", "md": "26x26px", "lg": "27x27px" },
        "pet": { "mobile": "44x20px", "sm": "50x23px", "md": "56x26px", "lg": "58x27px" }
      }
    },
    "LevelBadge": {
      "classes": ["game-level-badge", "game-level-badge-max"],
      "standard": { "minWidth": "17px", "height": "14px", "padding": "0 3.5px", "fontSize": "0.68rem", "borderTopRightRadius": "5px" },
      "compact": { "minWidth": "13px", "height": "11px", "padding": "0 2.5px", "fontSize": "9px" }
    },
    "CountBadge": {
      "class": "game-count-badge",
      "specs": { "position": "top-left", "padding": "1px 4.5px", "fontSize": "0.72rem", "borderBottomRightRadius": "5px", "condition": "count > 1" }
    },
    "StatPill": {
      "class": "game-stat-pill",
      "specs": { "padding": "0.2rem 0.55rem", "gap": "0.35rem", "fontSize": "0.8rem", "borderRadius": "9999px", "border": "1.5px solid #3A2317" },
      "variants": ["default", "blue", "copper", "purple", "amber", "green"]
    },
    "ProgressBar": {
      "classes": ["game-progress-bar-slot", "game-progress-bar-fill", "game-progress-bar-fill-green"],
      "specs": { "height": "8px", "borderRadius": "9999px", "transition": "width 0.3s ease" }
    },
    "GameInput": {
      "classes": ["game-input-container", "game-input-tag-prefix", "game-input-field"],
      "specs": { "minHeight": "44px", "borderRadius": "12px", "border": "2.5px solid #5A5552", "fontSize": "1rem (16px)" }
    },
    "GraySegmented": {
      "classes": ["game-segmented-bar", "game-segmented-item", "game-segmented-item-active"],
      "specs": { "minHeight": "44px", "borderTopRadius": "10px", "fontSizeMobile": "0.72rem", "fontSizeDesktop": "0.85rem" }
    },
    "GameTab": {
      "classes": ["game-tab-strip", "game-tab-bar", "game-tab", "game-tab-active", "game-tab-inactive", "game-tab-cream-active", "game-tab-stone-inactive", "game-tab-wood-attached"],
      "specs": { "borderTopRadius": "12px", "fontSizeDesktop": "1.05rem", "fontSizeMobile": "0.85rem" }
    },
    "GameWindow": {
      "classes": ["game-window-cream", "game-window-frame"],
      "variants": ["cream", "bare"]
    },
    "GamePanel": {
      "classes": ["game-panel", "game-panel-wood", "game-panel-blue", "game-panel-dark", "game-panel-cream", "game-panel-header", "game-slot-well", "game-cc-well"],
      "variants": ["wood", "blue", "dark", "cream"]
    },
    "SectionPanel": {
      "class": "game-section-panel",
      "specs": { "border": "3px solid #261810", "borderRadius": "16px", "padding": "12px / 16px" }
    }
  }
}
