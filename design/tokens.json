  "borders": {
    "creamWindow": "4px solid #5A5552",
    "woodWindowFrame": "3.5px solid #28160C",
    "panel": "3.5px solid",
    "panelHeaderBottom": "2.5px solid #24140C",
    "sectionPanel": "3px solid #261810",
    "tabStripBottom": "3px solid #28160C",
    "tabActive": "3px solid #28160C",
    "tabInactive": "2.5px solid #140A04",
